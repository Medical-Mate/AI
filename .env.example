# 복사해서 .env 로 저장. .env 는 .gitignore 에 있다 — 절대 커밋하지 않는다.
#   cp .env.example .env

# --- LLM 공급자 (eval 비교 대상). 쓰지 않는 공급자는 비워 두면 된다 ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# google-genai SDK는 GOOGLE_API_KEY 또는 GEMINI_API_KEY 둘 중 하나를 읽는다
GOOGLE_API_KEY=

# --- Langfuse (트레이싱) — 없으면 트레이싱만 꺼지고 나머지는 동작 ---
# 이 두 줄에 트레이스가 쌓인다. 로컬·eval은 eval 프로젝트 키를 넣는다(운영 키를 넣으면 eval이 운영 기록과 섞인다)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 가입한 리전에 맞춰 하나만. EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
# (SDK v4는 LANGFUSE_BASE_URL을 읽는다. LANGFUSE_HOST가 아니다) 우리 프로젝트는 US
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# MEDIMATE_TRACING=off          # 키가 있어도 끈다
# MEDIMATE_TRACE_CONTENT=on     # 입력·출력 본문을 보낸다. 기본 가림 — 운영은 웹·앱 안내 반영 뒤에만(#127, docs/observability.md)
# MEDIMATE_ENV=eval             # Langfuse environment 태그(운영 서버는 prod)
#
# 운영 트레이스 **조회**용 — 운영 프로젝트(medical-mate-prod)의 키. 트레이싱 코드는 이 이름을 읽지 않는다.
# 운영 서버에는 백엔드가 위 LANGFUSE_PUBLIC_KEY/SECRET_KEY 자리에 이 키를 넣는다(#127)
LANGFUSE_PROD_PUBLIC_KEY=
LANGFUSE_PROD_SECRET_KEY=

# --- API 서버 (medimate.api.app) — Extractor 공급자·모델. 비우면 기본 bedrock / apac.amazon.nova-pro-v1:0 ---
# 모델 id는 providers.PRICES의 문자열 그대로. 공백·오타면 프롬프트가 조용히 extract-v3로 떨어진다(/health.extractor로 확인)
MEDIMATE_PROVIDER=bedrock
MEDIMATE_MODEL=apac.amazon.nova-pro-v1:0
# 공개 데모의 프로세스 전역 일일 상한. 비우면 꺼진다
MEDIMATE_DAILY_BUDGET_USD=
# 일일 상한의 날짜 경계. IANA 시간대 이름
MEDIMATE_BUDGET_RESET_TZ=Asia/Seoul
# 선택: 날짜와 누적액을 재시작 뒤에도 복구할 파일 경로
MEDIMATE_BUDGET_STATE_FILE=
# 브라우저가 AI 서버를 직접 부를 때만. 쉼표 구분, `*` 금지
MEDIMATE_CORS_ORIGINS=

# --- eval 러너 ---
# 모델당 지출 상한(USD). CLI --budget 이 우선한다
MEDIMATE_EVAL_BUDGET_USD=0.50
