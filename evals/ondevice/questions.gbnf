char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
items ::= "[" space items-item ("," space items-item){0,4} space "]"
items-item ::= "{" space items-item-text-kv "," space items-item-source-kv space "}"
items-item-source ::= "\"" char{0,24} "\""
items-item-source-kv ::= "\"source\"" space ":" space items-item-source
items-item-text ::= "\"" char{0,40} "\""
items-item-text-kv ::= "\"text\"" space ":" space items-item-text
items-kv ::= "\"items\"" space ":" space items
root ::= "{" space items-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
