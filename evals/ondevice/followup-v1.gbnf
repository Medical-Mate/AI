char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
day ::= integer | null
day-kv ::= "\"day\"" space ":" space day
days ::= integer | null
days-kv ::= "\"days\"" space ":" space days
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
month ::= integer | null
month-kv ::= "\"month\"" space ":" space month
null ::= "null"
root ::= "{" space text-kv "," space days-kv "," space month-kv "," space day-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
text-kv ::= "\"text\"" space ":" space string
