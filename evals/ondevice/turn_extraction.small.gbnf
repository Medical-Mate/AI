boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
chief-complaint ::= string | null
chief-complaint-kv ::= "\"chief_complaint\"" space ":" space chief-complaint
chief-complaint-rest ::= ( "," space updates-kv )? updates-rest
notes ::= "[" space (string ("," space string){0,2})? space "]"
notes-kv ::= "\"notes\"" space ":" space notes
notes-rest ::= ( "," space wants-to-stop-kv )?
null ::= "null"
ref-defs-Axis ::= ("\"site\"" | "\"onset\"" | "\"character\"" | "\"radiation\"" | "\"associated\"" | "\"time_course\"" | "\"exacerbating_relieving\"" | "\"severity\"")
ref-defs-AxisUpdate ::= "{" space ref-defs-AxisUpdate-axis-kv "," space ref-defs-AxisUpdate-status-kv "," space ref-defs-AxisUpdate-value-kv "," space ref-defs-AxisUpdate-evidence-kv space "}"
ref-defs-AxisUpdate-axis ::= ref-defs-AxisUpdate-axis-0 | ref-defs-AxisUpdate-axis-1
ref-defs-AxisUpdate-axis-0 ::= ref-defs-Axis
ref-defs-AxisUpdate-axis-1 ::= ref-defs-PostAxis
ref-defs-AxisUpdate-axis-kv ::= "\"axis\"" space ":" space ref-defs-AxisUpdate-axis
ref-defs-AxisUpdate-evidence ::= "\"" char+ "\""
ref-defs-AxisUpdate-evidence-kv ::= "\"evidence\"" space ":" space ref-defs-AxisUpdate-evidence
ref-defs-AxisUpdate-status ::= ref-defs-FieldStatus
ref-defs-AxisUpdate-status-kv ::= "\"status\"" space ":" space ref-defs-AxisUpdate-status
ref-defs-AxisUpdate-value-kv ::= "\"value\"" space ":" space string
ref-defs-FieldStatus ::= ("\"not_asked\"" | "\"filled\"" | "\"unknown\"" | "\"skipped\"" | "\"ambiguous\"")
ref-defs-PostAxis ::= ("\"heard_diagnosis\"" | "\"medication\"" | "\"tests_procedures\"" | "\"follow_up\"" | "\"instructions\"" | "\"open_questions\"")
root ::= "{" space  (chief-complaint-kv chief-complaint-rest | updates-kv updates-rest | notes-kv notes-rest | wants-to-stop-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
updates ::= "[" space (updates-item ("," space updates-item){0,3})? space "]"
updates-item ::= ref-defs-AxisUpdate
updates-kv ::= "\"updates\"" space ":" space updates
updates-rest ::= ( "," space notes-kv )? notes-rest
wants-to-stop-kv ::= "\"wants_to_stop\"" space ":" space boolean
